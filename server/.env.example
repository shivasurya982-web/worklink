# WorkLink AI - Server Environment Variables Example

# Server Config
PORT=5000
NODE_ENV=development

# MongoDB
# Local: mongodb://localhost:27017/worklink-ai
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/worklink-ai
MONGO_URI=mongodb://localhost:27017/worklink-ai

# JWT
JWT_SECRET=your_secret_key_here
JWT_EXPIRE=30d

# Email (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_SECURE=false
EMAIL_USER=your_user
EMAIL_PASS=your_pass
EMAIL_FROM=WorkLink AI <noreply@worklinkai.com>
EMAIL_FROM_NAME=WorkLink AI

# Client URL (For CORS and redirect links)
CLIENT_URL=http://localhost:5173
